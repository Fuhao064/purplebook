{
  "manifest_version": 3,
  "name": "PurpleBook — 小红书纯净信息流",
  "short_name": "PurpleBook",
  "version": "0.3.4",
  "description": "小红书纯净信息流，按 / 进入纯净搜索；支持弹窗搜索、选中文字右键搜索与页面精简。",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PurpleBook — 纯净信息流与搜索",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-pure-mode": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "切换纯净信息流"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "shared.js",
        "content.js",
        "search.js"
      ],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/Fuhao064/purplebook"
}
